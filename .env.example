# Optional still JPEG URL, e.g. http://192.168.1.50/capture.
ESP32_CAPTURE_URL=
# Entrance and exit cameras. ESP32_CAPTURE_URL is the entrance compatibility alias.
ESP32_ENTRANCE_CAPTURE_URL=
ESP32_EXIT_CAPTURE_URL=

# Google Gemini API. Obtain a key from Google AI Studio; never commit it.
GEMINI_API_KEY=
# Optional additional keys. Rotate through configured keys between entrance classifications.
GEMINI_API_KEY_SECONDARY=
GEMINI_API_KEY_TERTIARY=
# Override only with a Gemini model available to your project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Request timeout in seconds. The default model caps this at 8 seconds, and the fallback at 15.
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MIN_VEHICLE_CONFIDENCE=0.60
# Default local PaddleOCR (Thai + English, CPU).
PADDLEOCR_MIN_CONFIDENCE=0.60
# Optional EasyOCR comparison engine.
EASYOCR_MIN_CONFIDENCE=0.60

# Durable local parking ledger and photo archive. Blank uses the project defaults.
# PARKING_DATABASE_PATH=/absolute/path/to/parking.sqlite3
# PARKING_STORAGE_PATH=/absolute/path/to/photos

# Cloud parking backend. Keep the real secret in the ignored local .env.
PARKING_BACKEND=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=intelligence-parking-lot
SENSOR_INTEGRATION_TOKEN=
# Enable after physically mapping and connecting sensors for every usable bay.
PARKING_REQUIRE_FRESH_SENSORS=false

