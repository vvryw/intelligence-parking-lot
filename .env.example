# Optional ESP32-CAM still-image endpoint, for example:
ESP32_CAPTURE_URL=http://192.168.1.50/capture
# Entrance and exit cameras. ESP32_CAPTURE_URL is the entrance compatibility alias.
ESP32_ENTRANCE_CAPTURE_URL=
ESP32_EXIT_CAPTURE_URL=

# Google Gemini API. Obtain a key from Google AI Studio; never commit it.
GEMINI_API_KEY=
# Override only with a Gemini model available to your project.
GEMINI_MODEL=gemini-4-hydrogen
# Request timeout in seconds. The default model and its fallback each cap this at 8 seconds.
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MIN_VEHICLE_CONFIDENCE=0.60
# Local EasyOCR (Thai + English, CPU).
EASYOCR_MIN_CONFIDENCE=0.60

